          "name": "Get flight tracks",
          "request": {
            "name": "Get flight tracks",
            "description": {
              "content": "Returns the full positional track of a specific flight identified by its FR24 flight ID. Provides a time-ordered sequence of latitude, longitude, altitude, speed, and heading records spanning the entire flight from departure to arrival.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "flight-tracks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "flight_id",
                  "value": "<string>",
                  "description": "(Required) Flightradar24 ID of the flight in hexadecimal format (e.g., \"34242a02\")."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
